---
import { site } from '@/data/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sectionPath = (id: string) => `${baseUrl}#${id}`;

const links = [
  { href: sectionPath('projects'), label: 'Proyectos' },
  { href: sectionPath('how-i-think'), label: 'Cómo pienso' },
  { href: sectionPath('quien-soy'), label: 'Quién soy' },
  { href: sectionPath('logros'), label: 'Logros' },
  { href: sectionPath('devops'), label: 'DevOps' },
];
---

<header class="sticky top-0 z-50">
  <div class="mx-auto max-w-6xl px-4 pt-4">
    <nav class="glass-strong relative rounded-lg border-2 border-white/15 shadow-brutal">
      <div class="flex items-center justify-between px-4 py-3">
        <a href={baseUrl} class="flex items-center gap-2 group">
          <span class="inline-block w-3 h-3 bg-accent-lime border border-black animate-pulse-glow"></span>
          <span class="font-display font-bold tracking-tight text-lg">filipao<span class="text-accent-lime">vfx</span></span>
        </a>

        <ul class="hidden md:flex items-center gap-1">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="px-3 py-1.5 text-sm font-mono uppercase tracking-wider text-white/70 hover:text-white hover:bg-white/5 rounded transition"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>

        <a
          href={sectionPath('contact')}
          class="hidden md:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-bold uppercase tracking-wider border-2 border-black bg-accent-lime text-ink-950 shadow-[3px_3px_0_0_#000] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[5px_5px_0_0_#000] transition-transform"
        >
          Contactar →
        </a>

        <!-- Menú móvil: <details> nativo, cero JavaScript, accesible por teclado -->
        <details class="md:hidden nav-menu">
          <summary
            class="nav-menu__toggle flex items-center gap-2 px-3.5 py-3 font-mono text-xs font-bold uppercase tracking-wider border-2 border-black bg-accent-lime text-ink-950 shadow-[3px_3px_0_0_#000] cursor-pointer select-none"
            aria-label="Abrir menú de navegación"
          >
            <span class="nav-menu__bars" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            menú
          </summary>

          <div class="absolute left-0 right-0 top-full mt-2 z-50 glass-strong border-2 border-white/15 rounded-lg shadow-brutal-lg p-3">
            <ul class="flex flex-col">
              {links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="block px-4 py-3 font-mono text-sm uppercase tracking-wider text-white/80 border-b border-white/10 hover:text-white hover:bg-white/5 transition"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-3 grid gap-2">
              <a
                href={sectionPath('contact')}
                class="inline-flex items-center justify-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider border-2 border-black bg-accent-lime text-ink-950 shadow-[3px_3px_0_0_#000]"
              >
                Contactar →
              </a>
              <div class="grid grid-cols-2 gap-2">
                <a
                  href={site.github}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center justify-center px-3 py-3.5 font-mono text-[11px] uppercase tracking-wider border border-white/20 text-white/80"
                >
                  GitHub ↗
                </a>
                <a
                  href={site.linkedin}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center justify-center px-3 py-3.5 font-mono text-[11px] uppercase tracking-wider border border-white/20 text-white/80"
                >
                  LinkedIn ↗
                </a>
              </div>
            </div>
          </div>
        </details>
      </div>
    </nav>
  </div>
</header>
