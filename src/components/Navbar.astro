---
import { site } from '@/data/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sectionPath = (id: string) => `${baseUrl}#${id}`;

// Tres entradas, no siete: el menú nombra las tres cosas que alguien viene a
// buscar. Las demás secciones siguen en la página y se alcanzan bajando —
// «Cómo pienso», «Certificados» y «DevOps» por scroll, y el caso desde su
// botón dentro de Logros.
const links = [
  { id: 'projects', href: sectionPath('projects'), label: 'Proyectos' },
  { id: 'quien-soy', href: sectionPath('quien-soy'), label: 'Quién soy' },
  { id: 'logros', href: sectionPath('logros'), label: 'Logros' },
];
---

<header class="sticky top-0 z-50">
  <div class="mx-auto max-w-6xl px-4 pt-4">
    <nav class="glass-strong relative rounded-lg border-2 border-white/15 shadow-brutal">
      <div class="flex items-center justify-between px-4 py-3">
        <!-- La marca: una rejilla de cuatro celdas con una encendida. Dice de
             dónde viene el trabajo —píxeles— y rima con el punto-por-comentario
             del caso. Quieta por defecto; la celda viaja una sola vez al pasar
             el cursor, en vez del latido infinito que tenía antes. -->
        <a
          href={baseUrl}
          aria-label="filipaovfx — inicio"
          class="group flex items-center gap-2.5 rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-accent-lime/70 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900"
        >
          <svg viewBox="0 0 14 14" width="14" height="14" class="shrink-0 overflow-visible" aria-hidden="true">
            <rect x="0" y="0" width="6" height="6" fill="rgba(255,255,255,0.18)" />
            <rect x="8" y="0" width="6" height="6" fill="rgba(255,255,255,0.18)" />
            <rect x="0" y="8" width="6" height="6" fill="rgba(255,255,255,0.18)" />
            <rect x="8" y="8" width="6" height="6" fill="rgba(255,255,255,0.18)" />
            <rect
              x="0" y="0" width="6" height="6" fill="#c6ff3d"
              class="transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] motion-safe:group-hover:translate-x-2 motion-safe:group-hover:translate-y-2"
            />
          </svg>
          <span class="font-display font-bold text-lg tracking-[-0.03em] leading-none">
            filipao<span class="text-accent-lime">vfx</span>
          </span>
        </a>

        <ul class="hidden md:flex items-center gap-2">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                data-nav={l.id}
                class="nav-link px-3 py-2 text-sm font-mono uppercase tracking-wider text-white/65 outline-none transition-colors hover:text-white focus-visible:text-white"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>

        <a
          href={sectionPath('contact')}
          class="hidden md:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-bold uppercase tracking-wider border-2 border-black bg-accent-lime text-ink-950 shadow-[3px_3px_0_0_#000] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[5px_5px_0_0_#000] transition-transform"
        >
          Contactar →
        </a>

        <!-- Menú móvil: <details> nativo, cero JavaScript, accesible por teclado -->
        <details class="md:hidden nav-menu">
          <summary
            class="nav-menu__toggle flex items-center gap-2 px-3.5 py-3 font-mono text-xs font-bold uppercase tracking-wider border-2 border-black bg-accent-lime text-ink-950 shadow-[3px_3px_0_0_#000] cursor-pointer select-none"
            aria-label="Abrir menú de navegación"
          >
            <span class="nav-menu__bars" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            menú
          </summary>

          <div class="absolute left-0 right-0 top-full mt-2 z-50 glass-strong border-2 border-white/15 rounded-lg shadow-brutal-lg p-3">
            <ul class="flex flex-col">
              {links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    data-nav={l.id}
                    class="nav-link--mobile block border-b border-white/10 px-4 py-3 font-mono text-sm uppercase tracking-wider text-white/80 transition hover:bg-white/5 hover:text-white"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-3 grid gap-2">
              <a
                href={sectionPath('contact')}
                class="inline-flex items-center justify-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider border-2 border-black bg-accent-lime text-ink-950 shadow-[3px_3px_0_0_#000]"
              >
                Contactar →
              </a>
              <div class="grid grid-cols-2 gap-2">
                <a
                  href={site.github}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center justify-center px-3 py-3.5 font-mono text-[11px] uppercase tracking-wider border border-white/20 text-white/80"
                >
                  GitHub ↗
                </a>
                <a
                  href={site.linkedin}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center justify-center px-3 py-3.5 font-mono text-[11px] uppercase tracking-wider border border-white/20 text-white/80"
                >
                  LinkedIn ↗
                </a>
              </div>
            </div>
          </div>
        </details>
      </div>
    </nav>
  </div>
</header>

<style>
  /* El subrayado entra desde la izquierda al pasar el cursor y se queda
     puesto en la sección que estás leyendo. Es el único movimiento de la
     barra: el latido infinito que había antes se fue. */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.3rem;
    height: 2px;
    background: theme('colors.accent.lime');
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[data-active]::after {
    transform: scaleX(1);
  }
  .nav-link[data-active],
  .nav-link--mobile[data-active] {
    color: #fff;
  }
  .nav-link--mobile[data-active] {
    border-left: 2px solid theme('colors.accent.lime');
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  // Marca la entrada de la sección que ocupa el centro de la pantalla. Si la
  // página no tiene esas secciones —el caso, por ejemplo— no pasa nada.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = [...new Set(navLinks.map((a) => a.dataset.nav))]
    .map((id) => document.getElementById(id!))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of navLinks) {
            link.toggleAttribute('data-active', link.dataset.nav === entry.target.id);
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }
</script>
