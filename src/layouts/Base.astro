---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
};

const {
  title = 'FilipaoVfx — Sistemas, producto y arquitectura',
  description = 'Portfolio de Juan Felipe González (FilipaoVfx): sistemas, arquitectura y producto. CrackingWall, Clippy, Indexer.',
  image = '/og.png',
  noindex = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assetPath = (path: string) => `${baseUrl}${path.replace(/^\/+/, '')}`;

// URL canónica con slash final: coincide exactamente con lo que emite el sitemap
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(assetPath(image), Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.alias,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: new URL(baseUrl, Astro.site).href,
  image: ogImage,
  sameAs: [site.github, site.linkedin],
  knowsAbout: [
    'Arquitectura de software',
    'DevOps',
    'CI/CD',
    'Edge computing',
    'SEO técnico',
    'Ingeniería de datos',
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'Diplomado en Fundamentos de DevOps',
    credentialCategory: 'Diplomado',
    educationalLevel: '96 horas',
    recognizedBy: {
      '@type': 'CollegeOrUniversity',
      name: 'Universidad de La Sabana — Facultad de Ingeniería',
    },
    dateCreated: '2026-07-24',
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#06060a" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FilipaoVfx" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body class="min-h-screen relative overflow-x-hidden">
    <Navbar />
    <main class="relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
