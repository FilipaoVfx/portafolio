---
import Base from '@/layouts/Base.astro';
import PivotFlow from '@/components/pivot/PivotFlow.tsx';
import BeforeAfter from '@/components/pivot/BeforeAfter.astro';
import { projects } from '@/data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

const accentClass = {
  lime: 'text-accent-lime',
  electric: 'text-accent-electric',
  magenta: 'text-accent-magenta',
};
const statusLabel = {
  live: 'en vivo',
  beta: 'beta',
  wip: 'en proceso',
};
const a = accentClass[project.accent];
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sectionPath = (id: string) => `${baseUrl}#${id}`;
---

<Base title={`${project.title} — FilipaoVfx`} description={project.tagline}>
  <article class="relative pt-12 pb-20">
    <div class="mx-auto max-w-4xl px-4">
      <a href={sectionPath('projects')} class="font-mono text-xs uppercase tracking-[0.25em] text-white/50 hover:text-white transition">
        ← volver
      </a>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <span class="chip uppercase">{statusLabel[project.status]}</span>
        {project.stack.map((s) => (
          <span class="chip">{s}</span>
        ))}
      </div>

      <h1 class={`heading-display text-5xl md:text-7xl mt-6 ${a}`}>
        {project.title}
      </h1>
      <p class="mt-4 text-xl text-white/70 max-w-2xl">{project.tagline}</p>

      <div class="mt-12 prose-invert space-y-12">
        <section>
          <div class="label-mono">// contexto</div>
          <p class="mt-3 text-white/80 leading-relaxed">{project.description}</p>
        </section>

        {project.pivot && (
          <section class="not-prose">
            <div class="max-w-3xl">
              <h2 class="heading-display text-3xl md:text-5xl leading-tight">
                La decisión que no se ve en el código.
              </h2>
              <p class="mt-5 text-white/70 text-lg leading-relaxed">
                Cualquiera aprende un stack. Lo caro de aprender es mirar algo
                que funciona, que costó meses, y aceptar que la mitad sobra. Este
                proyecto existe porque hice ese corte — y el video de abajo es
                exactamente dónde lo hice.
              </p>
            </div>

            <div class="mt-10">
              <PivotFlow client:visible />
            </div>

            <div class="mt-10 grid gap-5 md:grid-cols-3">
              <div class="border-l-2 border-white/15 pl-5">
                <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/55">lo que conservé</div>
                <p class="mt-2.5 text-sm leading-relaxed text-white/75">
                  La ingesta y el corpus: READMEs extraídos, limpiados y
                  clasificados con evidencia trazable. Meses de trabajo que
                  siguen corriendo hoy bajo otra fachada.
                </p>
              </div>
              <div class="border-l-2 border-white/15 pl-5">
                <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/55">lo que corté</div>
                <p class="mt-2.5 text-sm leading-relaxed text-white/75">
                  El ranking por reglas y la interfaz web entera. Funcionaban.
                  Ese era el problema: funcionar no es lo mismo que servir.
                </p>
              </div>
              <div class="border-l-2 border-accent-lime/70 pl-5">
                <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent-lime">lo que aprendí</div>
                <p class="mt-2.5 text-sm leading-relaxed text-white/75">
                  Pivotar rápido no es cambiar de idea rápido: es tener el
                  sistema suficientemente separado como para poder cortar por
                  una junta y no por el medio.
                </p>
              </div>
            </div>

            <div class="mt-20 md:mt-24">
              <BeforeAfter />
            </div>
          </section>
        )}

        <section class="grid md:grid-cols-2 gap-5">
          <div class="brutal-dark p-6">
            <div class="label-mono mb-2">// problema</div>
            <p class="text-sm leading-relaxed text-white/85">{project.problem}</p>
          </div>
          <div class="brutal-dark p-6">
            <div class="label-mono mb-2">// solución</div>
            <p class="text-sm leading-relaxed text-white/85">{project.solution}</p>
          </div>
        </section>

        <section>
          <div class="label-mono">// arquitectura</div>
          <ol class="mt-4 space-y-2">
            {project.architecture.map((step, i) => (
              <li class="flex items-start gap-4 glass border border-white/10 px-5 py-3">
                <span class={`font-mono text-sm font-bold ${a} min-w-[2rem]`}>
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-mono text-sm text-white/85 leading-relaxed">{step}</span>
              </li>
            ))}
          </ol>
        </section>

        <section>
              <div class="label-mono">// decisiones técnicas</div>
          <div class="mt-4 grid md:grid-cols-2 gap-4">
            {project.decisions.map((d) => (
              <div class="glass-strong border border-white/15 p-6">
                <h3 class={`heading-display text-lg ${a}`}>{d.title}</h3>
                <p class="mt-2 text-sm text-white/75 leading-relaxed">{d.body}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <div class="label-mono">// aprendizajes</div>
          <ul class="mt-4 space-y-2">
            {project.learnings.map((l) => (
              <li class="flex items-start gap-3 px-4 py-3 brutal-dark">
                <span class={`mt-1.5 inline-block w-2 h-2 ${project.accent === 'lime' ? 'bg-accent-lime' : project.accent === 'electric' ? 'bg-accent-electric' : 'bg-accent-magenta'}`} />
                <span class="text-sm text-white/85 leading-relaxed">{l}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="pt-8 border-t border-white/10 flex flex-wrap gap-3">
          {project.link && (
            <a href={project.link} class="btn-brutal" target="_blank" rel="noreferrer">
              Ver demo ↗
            </a>
          )}
          {project.repo && (
            <a href={project.repo} class="btn-ghost" target="_blank" rel="noreferrer">
              Código ↗
            </a>
          )}
          <a href={sectionPath('contact')} class="btn-ghost">Contactar →</a>
        </section>
      </div>
    </div>
  </article>
</Base>
