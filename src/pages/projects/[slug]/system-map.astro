---
import Base from '@/layouts/Base.astro';
import SystemMap from '@/components/system-map/SystemMap.tsx';
import { projects } from '@/data/projects';
import { getSystemMap, systemMapSlugs } from '@/lib/system-map';
import type { Architecture } from '@/lib/system-map/types';

export function getStaticPaths() {
  return systemMapSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const ir = getSystemMap(slug!) as Architecture;
const project = projects.find((p) => p.slug === slug);

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const routePath = (path: string) => `${baseUrl}${path.replace(/^\/+/, '')}`;

const commitShort = ir.source.commit.slice(0, 7);
const commitUrl = `${ir.source.url}/commit/${ir.source.commit}`;
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('es-CO', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(iso));

const externalCount = ir.components.filter((c) => c.type === 'external' || c.type === 'vector-store').length;
const stats = [
  { label: 'Componentes', value: ir.components.length },
  { label: 'Relaciones', value: ir.relationships.length },
  { label: 'Flujos', value: ir.flows.length },
  { label: 'Servicios externos', value: externalCount },
];
const { codeFiles, mappedFiles } = ir.analysis.coverage;
const languages = Object.entries(ir.analysis.languages)
  .filter(([lang]) => !['Markdown', 'JSON', 'YAML'].includes(lang))
  .sort((a, b) => b[1].lines - a[1].lines)
  .slice(0, 4);
const totalFacts = Object.values(ir.analysis.factsByKind).reduce((n, v) => n + v, 0);
const confirmed = [...ir.components, ...ir.relationships].filter((e) => e.confidence === 'confirmed').length;
const totalElements = ir.components.length + ir.relationships.length;

const byId = new Map(ir.components.map((c) => [c.id, c]));
const componentTypeLabel: Record<string, string> = {
  client: 'Cliente', service: 'Servicio', module: 'Módulo', job: 'Job', database: 'Base de datos',
  'vector-store': 'Vector store', external: 'Externo', infrastructure: 'Infraestructura',
};
const confidenceText: Record<string, string> = {
  confirmed: '● confirmado', supported: '◐ respaldado', inferred: '△ inferido', unknown: '? desconocido',
};
const basisText: Record<string, string> = {
  observed: 'Hecho observado', documented: 'Decisión documentada', inferred: 'Inferencia del análisis',
};
const artifactHref = routePath(`/projects/${slug}/architecture.json`);
---

<Base
  title={`${ir.project.name} · System Map — FilipaoVfx`}
  description={`Arquitectura verificable de ${ir.project.name}: ${ir.components.length} componentes y ${ir.relationships.length} relaciones generados del código de ${ir.source.repository}@${commitShort}.`}
>
  <article class="relative pt-10 pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <a href={routePath(`/projects/${slug}`)} class="font-mono text-xs uppercase tracking-[0.25em] text-white/50 hover:text-white transition">
        ← {ir.project.name}
      </a>

      <header class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <div class="label-mono">system map</div>
          <h1 class="heading-display mt-3 text-5xl md:text-7xl text-accent-magenta">{ir.project.name}</h1>
          <p class="mt-4 max-w-2xl text-xl text-white/75 leading-relaxed">{ir.project.summary}</p>
          {ir.project.description && <p class="mt-3 max-w-2xl text-white/55 leading-relaxed">{ir.project.description}</p>}
          <div class="mt-6 flex flex-wrap gap-1.5">
            {ir.project.technologies.map((t) => <span class="chip">{t}</span>)}
          </div>
          <a href="#mapa" class="btn-brutal mt-8">Explorar arquitectura ↓</a>
        </div>

        <dl class="lg:col-span-5 brutal-dark p-5 md:p-6 font-mono text-xs">
          <div class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-3">
            <dt class="uppercase tracking-[0.2em] text-white/45">Repositorio</dt>
            <dd><a class="text-accent-electric underline decoration-accent-electric/30 underline-offset-4 hover:decoration-accent-electric break-all" href={ir.source.url} target="_blank" rel="noreferrer">{ir.source.repository} ↗</a></dd>
            <dt class="uppercase tracking-[0.2em] text-white/45">Commit</dt>
            <dd>
              <a class="text-accent-electric underline decoration-accent-electric/30 underline-offset-4 hover:decoration-accent-electric" href={commitUrl} target="_blank" rel="noreferrer">{commitShort} ↗</a>
              <span class="text-white/45"> · {ir.source.branch} · {formatDate(ir.source.committedAt)}</span>
            </dd>
            <dt class="uppercase tracking-[0.2em] text-white/45">Generado</dt>
            <dd class="text-white/75"><time datetime={ir.generatedAt}>{formatDate(ir.generatedAt)}</time></dd>
            <dt class="uppercase tracking-[0.2em] text-white/45">Cobertura</dt>
            <dd class="text-white/75">{mappedFiles} de {codeFiles} archivos de código mapeados</dd>
            <dt class="uppercase tracking-[0.2em] text-white/45">Evidencia</dt>
            <dd class="text-white/75">{confirmed} de {totalElements} elementos con evidencia directa</dd>
          </div>
        </dl>
      </header>

      <section aria-label="Resumen" class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
        {stats.map((s) => (
          <div class="border border-white/10 bg-white/[0.03] p-4">
            <div class="heading-display text-4xl text-white">{s.value}</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.2em] text-white/45">{s.label}</div>
          </div>
        ))}
      </section>

      {ir.findings.length > 0 && (
        <section class="mt-10" aria-labelledby="findings-title">
          <h2 id="findings-title" class="label-mono">// lo que el código corrige de la documentación</h2>
          <ul class="mt-4 grid gap-3 md:grid-cols-3">
            {ir.findings.map((f) => (
              <li class={`border-l-2 bg-black/25 p-4 ${f.severity === 'warning' ? 'border-accent-amber' : 'border-accent-electric/70'}`}>
                <div class={`font-mono text-[10px] uppercase tracking-[0.2em] ${f.severity === 'warning' ? 'text-accent-amber' : 'text-accent-electric'}`}>
                  {f.severity === 'warning' ? '▲ discrepancia' : '◇ hallazgo'}
                </div>
                <h3 class="mt-2 font-semibold leading-snug text-white">{f.title}</h3>
                {f.detail && <p class="mt-1.5 text-sm leading-relaxed text-white/60">{f.detail}</p>}
                <ul class="mt-2 grid gap-1">
                  {f.evidence.map((ev) => (
                    <li>
                      <a class="font-mono text-[11px] text-accent-electric/90 underline decoration-accent-electric/30 underline-offset-4 hover:decoration-accent-electric break-all" href={ev.url} target="_blank" rel="noreferrer">
                        {ev.path}{ev.dir ? '/' : ''}{ev.lines ? `:${ev.lines}` : ''} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section id="mapa" class="mt-14 scroll-mt-28" aria-label="Mapa interactivo">
        <SystemMap client:load ir={ir} />
      </section>

      <section class="mt-20 grid gap-8 lg:grid-cols-12" aria-labelledby="method-title">
        <div class="lg:col-span-5">
          <h2 id="method-title" class="heading-display text-2xl md:text-3xl">Cómo se generó este mapa</h2>
          <p class="mt-3 text-white/60 leading-relaxed">
            Nada de esto se dibujó a mano ni se calcula en tu navegador. Un pipeline de build lee el repositorio,
            extrae hechos estáticos, los cruza con una interpretación versionada y solo publica si todo valida.
          </p>
          <a href={artifactHref} class="btn-ghost mt-6 !px-4 !py-2.5 text-xs">Ver architecture.json ↗</a>
        </div>
        <ol class="lg:col-span-7 grid gap-2 font-mono text-sm">
          <li class="glass border border-white/10 px-5 py-3 flex gap-4"><span class="text-accent-magenta font-bold">01</span><span class="text-white/80">Checkout de <span class="text-white">{ir.source.repository}@{commitShort}</span>, excluyendo secretos, binarios y dependencias ({ir.analysis.filesScanned} archivos leídos).</span></li>
          <li class="glass border border-white/10 px-5 py-3 flex gap-4"><span class="text-accent-magenta font-bold">02</span><span class="text-white/80">Análisis estático: {totalFacts} hechos (imports, rutas, llamadas HTTP, tablas, RPC, migraciones, workflows).</span></li>
          <li class="glass border border-white/10 px-5 py-3 flex gap-4"><span class="text-accent-magenta font-bold">03</span><span class="text-white/80">Interpretación versionada: nombra componentes y explica decisiones; solo puede citar hechos que existen y nunca subir la confianza.</span></li>
          <li class="glass border border-white/10 px-5 py-3 flex gap-4"><span class="text-accent-magenta font-bold">04</span><span class="text-white/80">Validación: esquema, referencias, cada extracto contra su línea en el commit y escaneo de secretos.</span></li>
          <li class="glass border border-white/10 px-5 py-3 flex gap-4"><span class="text-accent-magenta font-bold">05</span><span class="text-white/80">JSON estático de {ir.schemaVersion === '0.1' ? 'esquema 0.1' : ir.schemaVersion} · {ir.generatorVersion} · {ir.analysisVersion}. Sin LLM ni análisis en runtime.</span></li>
        </ol>
      </section>

      <details class="mt-16 border-t border-white/10 pt-6 group">
        <summary class="cursor-pointer font-mono text-xs uppercase tracking-[0.22em] text-white/55 hover:text-white">
          Versión en texto del mapa
        </summary>
        <div class="mt-6 grid gap-10 lg:grid-cols-2">
          <section>
            <h2 class="heading-display text-xl">Componentes</h2>
            {ir.groups.map((g) => {
              const items = ir.components.filter((c) => c.group === g.id);
              return items.length > 0 && (
                <div class="mt-5">
                  <h3 class="label-mono">{g.name}</h3>
                  <dl class="mt-2 grid gap-2">
                    {items.map((c) => (
                      <div class="border-l border-white/15 pl-3">
                        <dt class="text-white">{c.name} <span class="font-mono text-[11px] text-white/45">· {componentTypeLabel[c.type]} · {confidenceText[c.confidence]}</span></dt>
                        <dd class="text-sm text-white/60">{c.summary}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              );
            })}
          </section>
          <section>
            <h2 class="heading-display text-xl">Relaciones</h2>
            <ul class="mt-5 grid gap-1.5 text-sm">
              {ir.relationships.map((r) => (
                <li class="text-white/70">
                  <span class="text-white">{byId.get(r.source)?.name}</span> → <span class="text-white">{byId.get(r.target)?.name}</span>: {r.label}
                  <span class="font-mono text-[11px] text-white/40"> · {confidenceText[r.confidence]}</span>
                </li>
              ))}
            </ul>
            <h2 class="heading-display mt-10 text-xl">Decisiones</h2>
            <ul class="mt-5 grid gap-3 text-sm">
              {ir.decisions.map((d) => (
                <li>
                  <span class="text-white">{d.title}</span>
                  <span class="font-mono text-[11px] text-white/40"> · {basisText[d.basis]}</span>
                  <p class="text-white/60">{d.why}</p>
                </li>
              ))}
            </ul>
            <h2 class="heading-display mt-10 text-xl">Lenguajes analizados</h2>
            <p class="mt-3 text-sm text-white/60">
              {languages.map(([lang, v]) => `${lang} (${v.lines.toLocaleString('es-CO')} líneas)`).join(' · ')}
            </p>
          </section>
        </div>
      </details>

      {project && (
        <nav class="mt-16 pt-8 border-t border-white/10 flex flex-wrap gap-3" aria-label="Más sobre el proyecto">
          <a href={routePath(`/projects/${slug}`)} class="btn-brutal">← Caso completo</a>
          {project.link && <a href={project.link} class="btn-ghost" target="_blank" rel="noreferrer">Ver demo ↗</a>}
          <a href={ir.source.url} class="btn-ghost" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      )}
    </div>
  </article>
</Base>
