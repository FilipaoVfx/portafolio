---
// El workflow dibujado como lo que es: un lienzo de nodos en serpentina.
// Las posiciones se calculan aquí y salen como SVG estático — sin JavaScript
// en el cliente, igual que el menú móvil del navbar.
import { electoral, workflow } from '@/data/electoral';

const NODE_W = 212;
const NODE_H = 92;
const GAP_X = 58;
const GAP_Y = 64;
const COLS = 3;
const PAD_Y = 16;
// El salto de fila sale por fuera del nodo: el lienzo necesita margen lateral
// suficiente para que esa curva no quede cortada contra el borde.
const PAD_X = 56;

const rows = Math.ceil(workflow.length / COLS);
const width = PAD_X * 2 + COLS * NODE_W + (COLS - 1) * GAP_X;
const height = PAD_Y * 2 + rows * NODE_H + (rows - 1) * GAP_Y;

// Serpentina: las filas pares corren a la derecha y las impares a la izquierda,
// así el recorrido se lee sin saltos y cabe en vertical.
const nodes = workflow.map((node, i) => {
  const row = Math.floor(i / COLS);
  const col = row % 2 === 0 ? i % COLS : COLS - 1 - (i % COLS);
  const x = PAD_X + col * (NODE_W + GAP_X);
  const y = PAD_Y + row * (NODE_H + GAP_Y);
  return { ...node, i, row, col, x, y, cx: x + NODE_W / 2, cy: y + NODE_H / 2 };
});

const edges = nodes.slice(1).map((to) => {
  const from = nodes[to.i - 1];
  if (from.row === to.row) {
    // Mismo renglón: puerto derecho a puerto izquierdo, o al revés si va a la izquierda.
    const forward = to.x > from.x;
    const x1 = forward ? from.x + NODE_W : from.x;
    const x2 = forward ? to.x : to.x + NODE_W;
    const dx = (x2 - x1) / 2;
    return { d: `M${x1},${from.cy} C${x1 + dx},${from.cy} ${x2 - dx},${to.cy} ${x2},${to.cy}`, key: to.id };
  }
  // Cambio de renglón: baja por el costado exterior.
  const side = from.col === COLS - 1 ? from.x + NODE_W : from.x;
  const out = from.col === COLS - 1 ? 34 : -34;
  return {
    d: `M${side},${from.cy} C${side + out},${from.cy} ${side + out},${to.cy} ${side},${to.cy} L${from.col === COLS - 1 ? to.x + NODE_W : to.x},${to.cy}`,
    key: to.id,
  };
});

const saved = Math.round((electoral.totals.discarded / electoral.totals.captured) * 100);
---

<div class="grid gap-8">
  <p class="max-w-2xl text-lg text-white/65 leading-relaxed">
    Un script hace esto una vez; el lote siguiente es el que duele. El orden de
    los nodos <span class="text-white">es</span> la decisión de arquitectura:
    todo lo barato ocurre antes de lo caro.
    <span class="text-white">{electoral.totals.discarded} de {electoral.totals.captured}</span>
    comentarios se caen en la compuerta y nunca se pagan — {saved}% menos
    llamadas al modelo, con el motivo del descarte escrito en la fila.
  </p>

  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.3]"
      style="background-image: radial-gradient(rgba(255,255,255,0.14) 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>

    <svg viewBox={`0 0 ${width} ${height}`} width="100%" class="relative block" role="img"
      aria-label={`Workflow de ${workflow.length} nodos: ${workflow.map((n) => n.title).join(', ')}`}>
      <defs>
        <marker id="wf-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L8,4 L0,8 z" fill="rgba(255,255,255,0.45)" />
        </marker>
      </defs>

      {edges.map((e) => (
        <path d={e.d} fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="1.5" marker-end="url(#wf-arrow)" />
      ))}

      {nodes.map((n) => (
        <g>
          <rect
            x={n.x} y={n.y} width={NODE_W} height={NODE_H}
            fill="#0a0a12"
            stroke={n.cost ? '#ff3dd1' : n.gate ? '#c6ff3d' : n.flag ? '#ffb13d' : 'rgba(255,255,255,0.22)'}
            stroke-width={n.cost || n.gate || n.flag ? 2 : 1.25}
          />
          <rect x={n.x} y={n.y} width="4" height={NODE_H}
            fill={n.cost ? '#ff3dd1' : n.gate ? '#c6ff3d' : n.flag ? '#ffb13d' : 'rgba(255,255,255,0.22)'} />
          <circle cx={n.x} cy={n.cy} r="4" fill="#06060a" stroke="rgba(255,255,255,0.4)" />
          <circle cx={n.x + NODE_W} cy={n.cy} r="4" fill="#06060a" stroke="rgba(255,255,255,0.4)" />
          <text x={n.x + 18} y={n.y + 26} font-family="'JetBrains Mono', ui-monospace, monospace" font-size="10"
            letter-spacing="1.6" fill="rgba(255,255,255,0.6)">
            {n.type.toUpperCase()}
          </text>
          <text x={n.x + 18} y={n.y + 50} font-family="'Bricolage Grotesque', system-ui, sans-serif" font-weight="700"
            font-size="17" fill="#ffffff">
            {n.title}
          </text>
          <text x={n.x + 18} y={n.y + 72} font-family="'JetBrains Mono', ui-monospace, monospace" font-size="10"
            fill={n.cost ? '#ff3dd1' : n.gate ? '#c6ff3d' : n.flag ? '#ffb13d' : 'rgba(255,255,255,0.55)'}>
            {n.cost ? 'se paga por ítem' : n.gate ? 'corta aquí' : n.flag ? 'valida el contrato' : `paso ${n.i + 1}`}
          </text>
        </g>
      ))}
    </svg>
  </div>

  <div class="flex flex-wrap gap-6 font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">
    <span class="flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 bg-accent-lime"></span>compuerta</span>
    <span class="flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 bg-accent-magenta"></span>nodo que cuesta</span>
    <span class="flex items-center gap-2"><span class="inline-block h-2.5 w-2.5 bg-accent-amber"></span>contrato de datos</span>
  </div>
</div>
