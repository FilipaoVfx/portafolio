---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.tsx';
import TimelineGraph from '@/components/TimelineGraph.tsx';
import ProjectCard from '@/components/ProjectCard.tsx';
import HowIThink from '@/components/HowIThink.astro';
import DevOps from '@/components/DevOps.astro';
import Contact from '@/components/Contact.astro';
import { projects } from '@/data/projects';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const assetPath = (path: string) => `${baseUrl}${path.replace(/^\/+/, '')}`;
---

<Base>
  <Hero />

  <section id="projects" class="relative py-28 md:py-36 scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 sm:px-8 md:px-12 lg:px-14">
      <div class="mb-14 md:mb-20">
        <h2 class="heading-display text-3xl md:text-5xl">Sistemas, no demos.</h2>
        <p class="mt-4 text-white/60 max-w-xl text-lg">
          Tres proyectos. Tres decisiones. Cada uno resuelve un problema real
          con arquitectura intencional.
        </p>
      </div>

      <div class="flex flex-col gap-12 md:gap-16">
        {projects.map((project, i) => (
          <ProjectCard project={project} index={i} />
        ))}
      </div>
    </div>
  </section>

  <HowIThink />

  <section id="quien-soy" class="relative py-28 md:py-36 scroll-mt-24 overflow-hidden">
    <div class="absolute inset-x-0 top-16 h-px bg-gradient-to-r from-transparent via-accent-lime/50 to-transparent"></div>
    <div class="mx-auto max-w-6xl px-6 sm:px-8 md:px-12 lg:px-14">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-5">
          <h2 class="heading-display text-4xl md:text-6xl leading-tight">
            De creador visual a constructor de sistemas.
          </h2>
          <div class="mt-8 flex items-start gap-5">
            <div class="relative shrink-0 w-24 h-24 border-2 border-black bg-accent-lime shadow-brutal">
              <img
                src={assetPath('/profile.jpg')}
                alt="Juan Felipe González"
                class="absolute inset-0 h-full w-full object-cover grayscale contrast-110"
                loading="lazy"
              />
            </div>
            <p class="text-white/70 text-lg leading-relaxed">
              Empecé vendiendo edición de video y terminé construyendo sistemas.
              En el medio hay un negocio que funcionó, un intento que fracasó y
              la decisión de aprender lo que me faltaba.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7 grid gap-5">
          <div class="border-2 border-white/80 bg-ink-950 p-5 md:p-6 shadow-[7px_7px_0_0_rgba(255,255,255,0.85)]">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="heading-display text-3xl md:text-4xl leading-tight text-accent-lime">2019</span>
              <span class="font-mono text-xs uppercase tracking-[0.22em] text-white/45">primer negocio · 15 años</span>
            </div>
            <p class="mt-4 text-sm md:text-base text-white/72 leading-relaxed">
              Monté un negocio de edición de video sin tener idea de lo que hacía.
              Vi un problema en mi entorno y quise resolverlo. Ahí aprendí lo que
              ningún curso enseña: detectar una necesidad y vender la solución.
            </p>
          </div>

          <div class="border-2 border-white/80 bg-ink-950 p-5 md:p-6 shadow-[7px_7px_0_0_rgba(255,255,255,0.85)]">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="heading-display text-3xl md:text-4xl leading-tight text-accent-electric">Fallé</span>
              <span class="font-mono text-xs uppercase tracking-[0.22em] text-white/45">el intento que no aguantó</span>
            </div>
            <p class="mt-4 text-sm md:text-base text-white/72 leading-relaxed">
              Quise convertirlo en algo más grande y no aguantó. Sabía algo de
              HTML y algo de JS, y no alcanzaba. La idea no era el cuello de
              botella: me faltaba criterio técnico para sostenerla.
            </p>
          </div>

          <div class="border-2 border-accent-magenta bg-ink-950 p-5 md:p-7 shadow-[9px_9px_0_0_rgba(255,61,209,0.75)]">
            <div class="grid gap-5 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:items-start">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="heading-display text-4xl md:text-5xl leading-tight text-accent-magenta">Sistemas</span>
                <span class="font-mono text-xs uppercase tracking-[0.22em] text-white/45">el giro</span>
              </div>
              <p class="text-base md:text-lg text-white/76 leading-relaxed">
                Ese fracaso me mostró el tamaño real del problema, y me expuso
                temprano a producto, arquitectura y aprendizaje autodidacta.
                Desde ahí dejé de pensar en pantallas sueltas y empecé a pensar
                en sistemas que se sostienen solos.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-10 border-2 border-black bg-ink-900 p-6 md:p-8 shadow-brutal-lg">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5">
            <h3 class="heading-display text-2xl md:text-3xl text-white leading-tight">
              Impulso convertido en método.
            </h3>
            <p class="mt-4 text-white/75 leading-relaxed">
              Hoy diseño y construyo sistemas que convierten ideas complejas en
              productos que funcionan.
            </p>
          </div>

          <div class="lg:col-span-7 grid gap-2 sm:grid-cols-2">
            {[
              ['entrada', 'visual + negocio'],
              ['aprendizaje', 'producto + código'],
              ['criterio', 'arquitectura + performance'],
              ['salida', 'sistemas funcionales'],
            ].map(([label, value]) => (
              <div class="flex items-center justify-between gap-4 border border-white/10 bg-black/20 px-4 py-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/45">
                  {label}
                </span>
                <span class="font-mono text-xs text-accent-lime text-right">
                  {value}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <TimelineGraph />

  <DevOps />

  <Contact />
</Base>
